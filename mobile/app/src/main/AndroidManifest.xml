<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Route choice: is the phone on the PC's Wi-Fi subnet, is the Tailscale VPN up. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- PC alerts arrive by UnifiedPush (#222). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The in-app updater's permissions are in src/github (#257): the Play build has none. -->
    <!-- Offers to remove the app from before the package rename (#254). Without it, API 28+ drops ACTION_DELETE silently. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Find installed UnifiedPush distributors (ntfy, …); package visibility on API 30+. -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <!-- The app before the package rename (#254): offer to remove it (LegacyAppNotice). -->
        <package android:name="io.github.jeiel85.claudeusage" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClaudeUsage"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing QR link. Not autoVerify: App Link verification needs assetlinks.json at the
                 jeiel85.github.io root; until then the install page's "open in app" button hands over. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="jeiel85.github.io" android:pathPrefix="/claude-usage-tray-windows/pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="claudeusage" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Pairing scanner: zxing's capture screen with focus/metering tuned for a monitor (#251),
             locked to portrait like the rest of the app. Same window setup as zxing's CaptureActivity. -->
        <activity
            android:name=".ui.PairScanActivity"
            android:clearTaskOnLaunch="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- UnifiedPush connector (AND_3). Exported because the distributor is another app;
             broadcasts are checked against our token and must decrypt with our key. -->
        <receiver
            android:name=".push.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".push.RaiseToForegroundService"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>
    </application>
</manifest>
