<Window x:Class="ClaudeUsageTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="400"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush"     Color="#0F1117"/>
        <SolidColorBrush x:Key="CardBrush"   Color="#1A1D2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2F45"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B92B3"/>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C4C9E0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#1A1D2E" BorderBrush="#2D2F45" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="Check" Data="M3,8 L7,12 L13,4"
                                      Stroke="#F1F5F9" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5A5F7A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#8B5CF6"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5F7A"/>
                                <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#1A1D2E"/>
            <Setter Property="Foreground"      Value="#F1F5F9"/>
            <Setter Property="BorderBrush"     Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CaretBrush"      Value="#A78BFA"/>
            <Setter Property="SelectionBrush"  Value="#8B5CF6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5F7A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar 다크 스타일은 App.xaml의 전역 implicit 스타일을 사용 (DRY) -->

        <!-- Dark Slider -->
        <Style x:Key="DarkSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Outer" Width="14" Height="14" Fill="#A78BFA"/>
                            <Ellipse x:Name="Inner" Width="6" Height="6" Fill="#0F1117"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Fill" Value="#C4B5FD"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Outer" Property="Fill" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background"      Value="#2D2F45"/>
            <Setter Property="Foreground"      Value="#8B5CF6"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20">
                            <Border Height="4" Background="{TemplateBinding Background}"
                                    CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#8B5CF6"
                                                        CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"         Value="#1A1D2E"/>
            <Setter Property="Foreground"         Value="#F1F5F9"/>
            <Setter Property="BorderBrush"        Value="#2D2F45"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="Height"             Value="32"/>
            <Setter Property="Padding"            Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾"
                                               Foreground="#8B92B3" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#1A1D2E" BorderBrush="#2D2F45" BorderThickness="1"
                                        CornerRadius="8" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5A5F7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#C4C9E0"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Padding"    Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent"
                                            CornerRadius="6" Margin="4,2">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2D2F45"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="#A78BFA"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="#5A5F7A"/>
                                            <Setter Property="Opacity"    Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Foreground"       Value="#A78BFA"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Lbl"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lbl" Property="Foreground" Value="#C4B5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Lbl" Property="Foreground" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer 링크 (작은 회색 톤) -->
        <Style x:Key="FooterLinkBtn" TargetType="Button" BasedOn="{StaticResource LinkBtn}">
            <Setter Property="Foreground" Value="#5A5F7A"/>
            <Setter Property="FontSize"   Value="10"/>
        </Style>

        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" Background="Transparent" Margin="0,0,0,10" IsItemsHost="True"/>
                            <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8B92B3"/>
            <Setter Property="Background" Value="#1A1D2E"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Margin" Value="0,0,6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2F45"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 (탭 내부) -->
        <Style x:Key="TabCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14,12"/>
        </Style>
    </Window.Resources>

    <Border Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Border Background="{StaticResource BgBrush}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#1A1D2E" CornerRadius="16,16,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙  " Foreground="#A78BFA" FontSize="14"/>
                            <TextBlock x:Name="TitleText" Foreground="#F1F5F9"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <!-- "저장됨 ✓" 인디케이터 — 변경 발생 시 잠깐 표시 -->
                        <TextBlock x:Name="LblSavedIndicator" Grid.Column="1"
                                   Text="✓" Foreground="#10B981" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Opacity="0"/>
                        <Button Grid.Column="2" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="CloseBtn_Click">
                            <TextBlock Text="✕" Foreground="#8B92B3" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2D2F45"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content — 4탭 구조 (스크롤 없음) -->
                <TabControl Grid.Row="1" Style="{StaticResource DarkTabControl}" Margin="16,14,16,8">
                    <!-- ===== TAB 1: 일반 ===== -->
                    <TabItem x:Name="TabGeneral" Style="{StaticResource DarkTabItem}">
                        <Border Style="{StaticResource TabCard}">
                            <StackPanel>
                                <TextBlock x:Name="LblGeneral" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkEnabled" Style="{StaticResource CheckStyle}" Click="Setting_Changed"/>
                                <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource CheckStyle}" Click="StartWithWindows_Changed"/>

                                <Border Height="1" Background="#2D2F45" Margin="0,8,0,8"/>

                                <TextBlock x:Name="LblLanguageSection" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbLanguage" Style="{StaticResource DarkCombo}" Margin="0,0,0,10" SelectionChanged="CmbLanguage_SelectionChanged">
                                    <ComboBoxItem x:Name="LangItemSystem" Tag="system"/>
                                    <ComboBoxItem Content="한국어" Tag="ko"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                    <ComboBoxItem Content="中文" Tag="zh"/>
                                    <ComboBoxItem Content="日本語" Tag="ja"/>
                                </ComboBox>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock x:Name="LblPollingInterval" Foreground="#C4C9E0" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPollingValue" Foreground="#A78BFA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1" Foreground="#5A5F7A" FontSize="10" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderPolling" Grid.Column="1" Minimum="1" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" ValueChanged="SliderPolling_ValueChanged"/>
                                    <TextBlock Grid.Column="2" Text="10" Foreground="#5A5F7A" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ===== TAB 2: 트레이 ===== -->
                    <TabItem x:Name="TabTray" Style="{StaticResource DarkTabItem}">
                        <Border Style="{StaticResource TabCard}">
                            <StackPanel>
                                <TextBlock x:Name="LblTrayDisplayMode" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbTrayDisplayMode" Style="{StaticResource DarkCombo}" Margin="0,0,0,8" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem x:Name="TrayItemAuto" Tag="auto"/>
                                    <ComboBoxItem x:Name="TrayItemClaude"   Content="Claude"     Tag="claude"/>
                                    <ComboBoxItem x:Name="TrayItemCodex"    Content="Codex"      Tag="codex"/>
                                    <ComboBoxItem x:Name="TrayItemGemini"   Content="Gemini CLI" Tag="gemini-cli"/>
                                    <ComboBoxItem x:Name="TrayItemOpenCode" Content="OpenCode"   Tag="opencode"/>
                                </ComboBox>
                                <TextBlock x:Name="LblTrayAutoHelp" Foreground="#5A5F7A" FontSize="10" Margin="4,0,0,8" TextWrapping="Wrap"/>
                                <CheckBox x:Name="ChkHideInactive" Style="{StaticResource CheckStyle}" Margin="0,0,0,8" Click="Setting_Changed"/>

                                <Border Height="1" Background="#2D2F45" Margin="0,4,0,8"/>
                                <TextBlock x:Name="LblVisibleProviders" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkVisibleClaude"   Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                    <CheckBox x:Name="ChkVisibleCodex"    Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                    <CheckBox x:Name="ChkVisibleGemini"   Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                    <CheckBox x:Name="ChkVisibleOpenCode" Style="{StaticResource CheckStyle}" Margin="0,0,0,4"  Click="Setting_Changed"/>
                                </WrapPanel>

                                <!-- v1.27.0: 표시 옵션 토글 -->
                                <Border Height="1" Background="#2D2F45" Margin="0,8,0,8"/>
                                <TextBlock x:Name="LblDisplayOptions" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkShowCodexPlanBadge"   Style="{StaticResource CheckStyle}" Margin="0,0,0,4" Click="Setting_Changed"/>
                                <CheckBox x:Name="ChkShowAbsoluteResetTime" Style="{StaticResource CheckStyle}" Margin="0,0,0,2" Click="Setting_Changed"/>
                                <TextBlock x:Name="LblShowAbsoluteResetTimeHint" Foreground="#5A5F7A" FontSize="10" Margin="2,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ===== TAB 3: 알림 ===== -->
                    <TabItem x:Name="TabAlerts" Style="{StaticResource DarkTabItem}">
                        <Border Style="{StaticResource TabCard}">
                            <StackPanel>
                                <TextBlock x:Name="LblThresholds" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkRateLimit"  Style="{StaticResource CheckStyle}" Click="Setting_Changed"/>
                                <CheckBox x:Name="ChkQuotaReset" Style="{StaticResource CheckStyle}" Click="Setting_Changed"/>
                                <WrapPanel Margin="0,2,0,4">
                                    <CheckBox x:Name="Chk50"  Content="50%"  Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                    <CheckBox x:Name="Chk75"  Content="75%"  Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                    <CheckBox x:Name="Chk90"  Content="90%"  Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                    <CheckBox x:Name="Chk100" Content="100%" Style="{StaticResource CheckStyle}" Margin="0,0,0,4"  Click="Setting_Changed"/>
                                </WrapPanel>
                                <Button x:Name="BtnTestNotification" Style="{StaticResource LinkBtn}" Margin="0,2,0,2" Click="BtnTestNotification_Click"/>
                                <TextBlock x:Name="LblTestNotificationHint" Foreground="#5A5F7A" FontSize="10" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ===== TAB 4: ntfy (압축) ===== -->
                    <TabItem x:Name="TabNtfy" Style="{StaticResource DarkTabItem}">
                        <Border Style="{StaticResource TabCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📱  " FontSize="13"/>
                                        <TextBlock x:Name="LblNtfyTitle" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="BtnNtfyDownload" Style="{StaticResource LinkBtn}" Click="BtnNtfyDownload_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="LblNtfyTopic" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                <TextBox  x:Name="TxtNtfyTopic" Style="{StaticResource DarkTextBox}" Padding="10,7" LostFocus="TxtNtfyTopic_LostFocus" KeyDown="TxtNtfyTopic_KeyDown"/>
                                <TextBlock x:Name="LblNtfySecurityWarning" Foreground="#FCD34D" FontSize="10" TextWrapping="Wrap" Margin="2,4,0,2" Visibility="Collapsed"/>
                                <TextBlock x:Name="LblNtfyHint" Foreground="#5A5F7A" FontSize="10" Margin="2,2,0,8"/>

                                <CheckBox x:Name="ChkNtfySendFromThisPc" Style="{StaticResource CheckStyle}" Margin="0,0,0,2" Click="Setting_Changed"/>
                                <TextBlock x:Name="LblNtfySendFromThisPcHint" Foreground="#5A5F7A" FontSize="10" TextWrapping="Wrap" Margin="2,0,0,0"/>

                                <!-- 압축에 따라 더 이상 마크업에서 사용되지 않는 라벨/링크들 — 호환성 위해 0 높이로 유지 (코드비하인드 ApplyLocalization 호출 안전) -->
                                <TextBlock x:Name="LblNtfyDesc" Visibility="Collapsed"/>
                                <TextBlock x:Name="LblStep2"    Visibility="Collapsed"/>
                                <TextBlock x:Name="LblStep3"    Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#141622" CornerRadius="0,0,16,16" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblDisclaimer" Grid.Column="0" Foreground="#3D4266"
                                   FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="BtnResetDefaults" Grid.Column="1"
                                Style="{StaticResource FooterLinkBtn}"
                                Click="BtnResetDefaults_Click"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
