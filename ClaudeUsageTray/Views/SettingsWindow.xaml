<Window x:Class="ClaudeUsageTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush"     Color="#0F1117"/>
        <SolidColorBrush x:Key="CardBrush"   Color="#1A1D2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2F45"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B92B3"/>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C4C9E0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#1A1D2E" BorderBrush="#2D2F45" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="Check" Data="M3,8 L7,12 L13,4"
                                      Stroke="#F1F5F9" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5A5F7A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#8B5CF6"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5F7A"/>
                                <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#1A1D2E"/>
            <Setter Property="Foreground"      Value="#F1F5F9"/>
            <Setter Property="BorderBrush"     Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CaretBrush"      Value="#A78BFA"/>
            <Setter Property="SelectionBrush"  Value="#8B5CF6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5F7A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ScrollBar (vertical) -->
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#2D2F45" CornerRadius="3" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A5F7A"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark Slider -->
        <Style x:Key="DarkSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Outer" Width="14" Height="14" Fill="#A78BFA"/>
                            <Ellipse x:Name="Inner" Width="6" Height="6" Fill="#0F1117"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Fill" Value="#C4B5FD"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Outer" Property="Fill" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background"      Value="#2D2F45"/>
            <Setter Property="Foreground"      Value="#8B5CF6"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20">
                            <Border Height="4" Background="{TemplateBinding Background}"
                                    CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#8B5CF6"
                                                        CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"         Value="#1A1D2E"/>
            <Setter Property="Foreground"         Value="#F1F5F9"/>
            <Setter Property="BorderBrush"        Value="#2D2F45"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="Height"             Value="32"/>
            <Setter Property="Padding"            Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾"
                                               Foreground="#8B92B3" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#1A1D2E" BorderBrush="#2D2F45" BorderThickness="1"
                                        CornerRadius="8" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5A5F7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#C4C9E0"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Padding"    Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent"
                                            CornerRadius="6" Margin="4,2">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2D2F45"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="#A78BFA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Foreground"       Value="#A78BFA"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Lbl"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lbl" Property="Foreground" Value="#C4B5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Lbl" Property="Foreground" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" Background="Transparent" Margin="0,0,0,8" IsItemsHost="True"/>
                            <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8B92B3"/>
            <Setter Property="Background" Value="#1A1D2E"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2F45"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Border Background="{StaticResource BgBrush}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>

                <!-- Header -->
                <Border Background="#1A1D2E" CornerRadius="16,16,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙  " Foreground="#A78BFA" FontSize="14"/>
                            <TextBlock x:Name="TitleText" Foreground="#F1F5F9"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="CloseBtn_Click">
                            <TextBlock Text="✕" Foreground="#8B92B3" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2D2F45"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="560">
                <StackPanel Margin="16,14,16,0">

                    <!-- General -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="LblGeneral" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkEnabled" Style="{StaticResource CheckStyle}" Click="Setting_Changed"/>
                            <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource CheckStyle}" Click="StartWithWindows_Changed"/>
                            <TextBlock x:Name="LblLanguageSection" Style="{StaticResource SectionLabel}" Margin="0,6,0,6"/>
                            <ComboBox x:Name="CmbLanguage" Style="{StaticResource DarkCombo}" Margin="0,0,0,8" SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem x:Name="LangItemSystem" Tag="system"/>
                                <ComboBoxItem Content="한국어" Tag="ko"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="中文" Tag="zh"/>
                                <ComboBoxItem Content="日本語" Tag="ja"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock x:Name="LblPollingInterval" Foreground="#C4C9E0" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPollingValue" Foreground="#A78BFA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1" Foreground="#5A5F7A" FontSize="10" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderPolling" Grid.Column="1" Minimum="1" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" ValueChanged="SliderPolling_ValueChanged"/>
                                <TextBlock Grid.Column="2" Text="10" Foreground="#5A5F7A" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tray -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="LblTrayDisplayMode" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbTrayDisplayMode" Style="{StaticResource DarkCombo}" Margin="0,0,0,8" SelectionChanged="Setting_Changed">
                                <ComboBoxItem x:Name="TrayItemAuto" Tag="auto"/>
                                <ComboBoxItem Content="Claude" Tag="claude"/>
                                <ComboBoxItem Content="Codex" Tag="codex"/>
                                <ComboBoxItem Content="Gemini CLI" Tag="gemini-cli"/>
                                <ComboBoxItem Content="OpenCode" Tag="opencode"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkHideInactive" Style="{StaticResource CheckStyle}" Margin="0,0,0,8" Click="Setting_Changed"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Gemini " Foreground="#C4C9E0" FontSize="11"/>
                                    <TextBlock x:Name="LblDailyGoalGemini" Foreground="#8B92B3" FontSize="11"/>
                                </StackPanel>
                                <TextBox x:Name="TxtGeminiGoal" Grid.Column="1" Style="{StaticResource DarkTextBox}" LostFocus="TxtGoal_LostFocus" PreviewTextInput="NumberValidationTextBox"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="OpenCode " Foreground="#C4C9E0" FontSize="11"/>
                                    <TextBlock x:Name="LblDailyGoalOpenCode" Foreground="#8B92B3" FontSize="11"/>
                                </StackPanel>
                                <TextBox x:Name="TxtOpenCodeGoal" Grid.Column="1" Style="{StaticResource DarkTextBox}" LostFocus="TxtGoal_LostFocus" PreviewTextInput="NumberValidationTextBox"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TabControl Style="{StaticResource DarkTabControl}" Margin="0,0,0,8">
                        <TabItem x:Name="TabAlerts" Header="Alerts" Style="{StaticResource DarkTabItem}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock x:Name="LblThresholds" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkRateLimit" Style="{StaticResource CheckStyle}" Click="Setting_Changed"/>
                                    <CheckBox x:Name="ChkQuotaReset" Style="{StaticResource CheckStyle}" Click="Setting_Changed"/>
                                    <WrapPanel Margin="0,2,0,4">
                                        <CheckBox x:Name="Chk50" Content="50%" Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                        <CheckBox x:Name="Chk75" Content="75%" Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                        <CheckBox x:Name="Chk90" Content="90%" Style="{StaticResource CheckStyle}" Margin="0,0,14,4" Click="Setting_Changed"/>
                                        <CheckBox x:Name="Chk100" Content="100%" Style="{StaticResource CheckStyle}" Margin="0,0,0,4" Click="Setting_Changed"/>
                                    </WrapPanel>
                                    <Button x:Name="BtnTestNotification" Style="{StaticResource LinkBtn}" Margin="0,2,0,2" Click="BtnTestNotification_Click"/>
                                    <TextBlock x:Name="LblTestNotificationHint" Foreground="#5A5F7A" FontSize="10" Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </TabItem>
                        <TabItem x:Name="TabNtfy" Header="ntfy" Style="{StaticResource DarkTabItem}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📱  " FontSize="13"/>
                                        <TextBlock x:Name="LblNtfyTitle" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LblNtfyDesc" Foreground="#8B92B3" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="① " Foreground="#8B92B3" FontSize="11"/>
                                        <Button x:Name="BtnNtfyDownload" Style="{StaticResource LinkBtn}" Click="BtnNtfyDownload_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LblStep2" Foreground="#8B92B3" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,1"/>
                                    <TextBlock x:Name="LblStep3" Foreground="#8B92B3" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,8"/>
                                    <TextBlock x:Name="LblNtfyTopic" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtNtfyTopic" Style="{StaticResource DarkTextBox}" Padding="10,7" LostFocus="TxtNtfyTopic_LostFocus" KeyDown="TxtNtfyTopic_KeyDown"/>
                                    <TextBlock x:Name="LblNtfySecurityWarning" Foreground="#FCD34D" FontSize="10" TextWrapping="Wrap" Margin="2,4,0,2" Visibility="Collapsed"/>
                                    <TextBlock x:Name="LblNtfyHint" Foreground="#5A5F7A" FontSize="10" Margin="2,2,0,8"/>
                                    <CheckBox x:Name="ChkNtfySendFromThisPc" Style="{StaticResource CheckStyle}" Margin="0,0,0,2" Click="Setting_Changed"/>
                                    <TextBlock x:Name="LblNtfySendFromThisPcHint" Foreground="#5A5F7A" FontSize="10" TextWrapping="Wrap" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>

                </StackPanel>
                </ScrollViewer>

                <!-- Disclaimer -->
                <TextBlock x:Name="LblDisclaimer" Margin="16,4,16,14" TextWrapping="Wrap" FontSize="10" Foreground="#3D4266"/>

            </StackPanel>
        </Border>
    </Border>
</Window>
