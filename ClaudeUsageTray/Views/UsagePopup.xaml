<Window x:Class="ClaudeUsageTray.Views.UsagePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Claude Usage"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0F1117"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1D2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2F45"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B92B3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentLight" Color="#A78BFA"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>

        <!-- Claude 바 (보라 그라디언트) -->
        <Style x:Key="UsageBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Codex 바 (초록) -->
        <Style x:Key="CodexBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="#10B981"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gemini 바 (파랑) -->
        <Style x:Key="GeminiBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="#3B82F6"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Extra Usage 바 (황금) -->
        <Style x:Key="ExtraBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="#F59E0B"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A78BFA"/>
        </Style>

        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="#1A1D2E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 투명 클릭 버튼 (버전 등) -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Border Background="{StaticResource BgBrush}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>

                <!-- Header -->
                <Border Background="#1A1D2E" CornerRadius="16,16,0,0" Padding="16,14,16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,8,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="A" Foreground="White" FontWeight="Bold"
                                           FontSize="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LblAppTitle}" Foreground="#F1F5F9"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LastUpdatedLabel}"
                                               Foreground="#5A5F7A" FontSize="10"/>
                                    <TextBlock Text=" · " Foreground="#3D4266" FontSize="10"/>
                                    <TextBlock Text="{Binding NextRefreshLabel}"
                                               Foreground="#3D4266" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Refresh button -->
                        <Button Grid.Column="1" x:Name="RefreshBtn"
                                Width="28" Height="28"
                                Cursor="Hand"
                                ToolTip="{Binding LblRefresh}"
                                Click="RefreshBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <TextBlock x:Name="Icon" Text="↻" Foreground="#5A5F7A" FontSize="14"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2D2F45"/>
                                                        <Setter TargetName="Icon" Property="Foreground" Value="#A78BFA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Icon" Property="Foreground" Value="#8B5CF6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Update banner -->
                <Border Padding="12,8" Margin="16,8,16,0"
                        Background="#1A2E1A" CornerRadius="8"
                        BorderBrush="#10B981" BorderThickness="1"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Cursor="Hand"
                                    Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibilityInverse}}">
                            <StackPanel.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding StartUpdateCommand}"/>
                            </StackPanel.InputBindings>
                            <TextBlock Text="↑ " Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding UpdateLabel}" Foreground="#6EE7B7" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <TextBlock Text="{Binding UpdateStatusText}" Foreground="#6EE7B7" FontSize="9"/>
                                <TextBlock Text="{Binding UpdateProgress, StringFormat={}{0}%}" Foreground="#10B981" FontSize="9" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="3" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error panel -->
                <Border Padding="12,8" Margin="16,4"
                        Background="#2D1515" CornerRadius="8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444"
                               FontSize="10" TextWrapping="Wrap"/>
                </Border>

                <!-- Provider Sections -->
                <StackPanel Margin="16,14,16,14">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding LblApiQuota}" Margin="0,0,0,12"/>

                    <!-- Claude Section -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#8B5CF6" Margin="0,0,8,0">
                                <TextBlock Text="C" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Claude" Foreground="#F1F5F9" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="6"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LblFiveHour}" Foreground="#F1F5F9" FontSize="10.5"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ClaudeShortPercent, StringFormat={}{0:P0}}" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ClaudeShortReset}" Foreground="#8B92B3" FontSize="10" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding ClaudeShortDepletion}" Foreground="#F59E0B" FontSize="10" Margin="0,2,0,0" Visibility="{Binding ClaudeShortDepletion, Converter={StaticResource StringToVisibility}}"/>
                            <ProgressBar Grid.Row="2" Value="{Binding ClaudeShortPercent}" Maximum="1" Style="{StaticResource UsageBarStyle}" Margin="0,4,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ClaudeShortSummary}" Foreground="#8B92B3" FontSize="10" Margin="0,3,0,10"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="6"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LblSevenDay}" Foreground="#F1F5F9" FontSize="10.5"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ClaudeLongPercent, StringFormat={}{0:P0}}" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ClaudeLongReset}" Foreground="#8B92B3" FontSize="10" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Grid.Row="2" Value="{Binding ClaudeLongPercent}" Maximum="1" Style="{StaticResource UsageBarStyle}" Margin="0,4,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ClaudeLongSummary}" Foreground="#8B92B3" FontSize="10" Margin="0,3,0,0"/>

                        <!-- Extra Usage (Claude only) -->
                        <Grid Margin="0,10,0,0" Visibility="{Binding ExtraUsageEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="6"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LblExtraCredits}" Foreground="#F1F5F9" FontSize="10.5"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ExtraUsagePercent, StringFormat={}{0:P0}}" Foreground="#F59E0B" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ExtraCreditsLabel}" Foreground="#8B92B3" FontSize="10" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="{Binding ExtraUsagePercent}" Maximum="1" Style="{StaticResource ExtraBarStyle}" Margin="0,4,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ClaudeErrorMessage}" Foreground="#EF4444" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding ClaudeHasError, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- History Chart (Claude 기준) -->
                        <Border Height="1" Background="#2D2F45" Margin="0,14,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="ChartTitleLabel" Text="{Binding HistoryChartTitle}" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border CornerRadius="4" BorderBrush="#2D2F45" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="Toggle7DayBtn" Click="Toggle7DayBtn_Click" Background="#2D2F45" Padding="6,2" BorderThickness="0"><TextBlock x:Name="Toggle7DayText" FontSize="10" Foreground="#F1F5F9"/></Button>
                                        <Button x:Name="ToggleHourlyBtn" Click="ToggleHourlyBtn_Click" Background="Transparent" Padding="6,2" BorderThickness="0"><TextBlock x:Name="ToggleHourlyText" FontSize="10" Foreground="#8B92B3"/></Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Canvas x:Name="HistoryCanvas" Height="60" Background="Transparent"/>

                        <!-- Today's Stats (Claude 세션 기준) -->
                        <Border Height="1" Background="#2D2F45" Margin="0,14,0,14"/>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding LblTodayTokens}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SessionsLabel}" Foreground="#8B92B3" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <UniformGrid Columns="2" Rows="2">
                            <Border Style="{StaticResource StatBox}" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblInput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding TodayInputTokens, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Foreground="#A78BFA"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="4,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblOutput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding TodayOutputTokens, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblCacheRead}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding TodayCacheRead, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Foreground="#34D399" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblCacheWrite}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding TodayCacheWrite, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Foreground="#FBBF24" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding TodayCostLabel}" Foreground="#8B92B3" FontSize="10" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Codex Section -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#10B981" Margin="0,0,8,0">
                                <TextBlock Text="X" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Codex" Foreground="#F1F5F9" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ChatGPT plan" Foreground="#F1F5F9" FontSize="10.5"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding CodexPercent, StringFormat={}{0:P0}}" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CodexReset}" Foreground="#8B92B3" FontSize="10" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding CodexPercent}" Maximum="1" Style="{StaticResource CodexBarStyle}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CodexSummary}" Foreground="#8B92B3" FontSize="10" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CodexNote}" Foreground="#5A5F7A" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Gemini Section -->
                    <StackPanel Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#3B82F6" Margin="0,0,8,0">
                                <TextBlock Text="G" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Gemini" Foreground="#F1F5F9" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gemini CLI" Foreground="#F1F5F9" FontSize="10.5"/>
                            <TextBlock Grid.Column="1" Text="{Binding GeminiRequestsLabel}" Foreground="#60A5FA" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                        <TextBlock Text="{Binding GeminiSummary}" Foreground="#8B92B3" FontSize="10" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding GeminiNote}" Foreground="#5A5F7A" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <Border Padding="16,12" Background="#1A1D2E" CornerRadius="0,0,16,16">
                    <Grid>
                        <!-- 좌측: 버전 클릭 → 업데이트 확인 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ManualCheckForUpdateCommand}"
                                    Style="{StaticResource GhostBtn}">
                                <TextBlock Text="{Binding CurrentVersionLabel}" Foreground="#5A5F7A" FontSize="9"/>
                            </Button>
                            <TextBlock Text="{Binding UpdateCheckLabel}" Foreground="#A78BFA" FontSize="9"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding UpdateCheckLabel, Converter={StaticResource StringToVisibility}}"/>
                        </StackPanel>
                        <!-- 우측: 설정 + 종료 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="SettingsBtn_Click" Cursor="Hand" Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                                                        <TextBlock x:Name="Icon" Text="⚙" Foreground="#5A5F7A" FontSize="13" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Icon" Property="Foreground" Value="#A78BFA"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Click="QuitBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="{Binding LblQuit}" Foreground="#B87171" FontSize="10" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Border>
</Window>
