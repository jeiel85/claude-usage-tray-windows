<Window x:Class="ClaudeUsageTray.Views.UsagePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Claude Usage"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0F1117"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1D2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2F45"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B92B3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentLight" Color="#A78BFA"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>

        <!-- Claude 바 (보라 그라디언트) -->
        <Style x:Key="UsageBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 페이스 오버레이 · 바닥 레이어: 사용량 전체를 주황으로. 위에 보라 레이어가 시간 이내 사용분을
             덮으므로, 시간 마커를 앞지른 초과분만 최종적으로 주황으로 남는다. -->
        <Style x:Key="PaceOverBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="#F59E0B"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 페이스 오버레이 · 상단 레이어: 시간 이내 사용분(=min(사용량,시간))을 보라로 덮는다.
             트랙은 투명이라 아래 주황 레이어를 가리지 않는다. -->
        <Style x:Key="PaceUsageBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Codex 바 (초록 그라디언트) -->
        <Style x:Key="CodexBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6EE7B7" Offset="0"/>
                                        <GradientStop Color="#10B981" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OpenCode 바 (오렌지) -->
        <Style x:Key="OpenCodeBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="#F97316"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gemini 바 (파랑) -->
        <Style x:Key="GeminiBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="#3B82F6"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Extra Usage 바 (황금) -->
        <Style x:Key="ExtraBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="#F59E0B"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Antigravity 바 (인디고) -->
        <Style x:Key="AntigravityBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#2D2F45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#A5B4FC" Offset="0"/>
                                        <GradientStop Color="#818CF8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A78BFA"/>
        </Style>

        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="#1A1D2E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 투명 클릭 버튼 (버전 등) -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 에이전트 행 클릭 버튼 — focus 전환용. 호버 시 살짝 톤 변화, focus 시 액센트 라인 -->
        <Style x:Key="AgentRowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1D2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PopupShell" Background="Transparent">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="8"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding KeepPopupAboveTaskbar}" Value="True">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Effect" Value="{x:Null}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border x:Name="PopupFrame">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                    <Setter Property="CornerRadius" Value="16"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding KeepPopupAboveTaskbar}" Value="True">
                            <Setter Property="Background" Value="#151A27"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border x:Name="PopupHeader" Grid.Row="0" Background="#1A1D2E" CornerRadius="16,16,0,0" Padding="16,14,16,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KeepPopupAboveTaskbar}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,8,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="A" Foreground="White" FontWeight="Bold"
                                           FontSize="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LblAppTitle}" Foreground="#F1F5F9"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LastUpdatedLabel}"
                                               Foreground="#5A5F7A" FontSize="10"/>
                                    <TextBlock Text=" · " Foreground="#3D4266" FontSize="10"/>
                                    <TextBlock Text="{Binding NextRefreshLabel}"
                                               Foreground="#3D4266" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Refresh button -->
                            <Button x:Name="RefreshBtn"
                                    Width="28" Height="28"
                                    Cursor="Hand"
                                    ToolTip="{Binding LblRefresh}"
                                    Click="RefreshBtn_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <TextBlock x:Name="Icon" Text="↻" Foreground="#5A5F7A" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#2D2F45"/>
                                                            <Setter TargetName="Icon" Property="Foreground" Value="#A78BFA"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Icon" Property="Foreground" Value="#8B5CF6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Settings button -->
                            <Button x:Name="HeaderSettingsBtn"
                                    Width="28" Height="28"
                                    Cursor="Hand"
                                    Margin="8,0,0,0"
                                    ToolTip="{Binding LblSettings}"
                                    Click="SettingsBtn_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <TextBlock x:Name="Icon" Text="⚙" Foreground="#5A5F7A" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#2D2F45"/>
                                                            <Setter TargetName="Icon" Property="Foreground" Value="#A78BFA"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Icon" Property="Foreground" Value="#8B5CF6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1">
                    <StackPanel x:Name="MiniUsageContent" Margin="12,8,12,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KeepPopupAboveTaskbar}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,5"
                              Visibility="{Binding ClaudeVm.IsActive, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Claude" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Grid.Column="1" Value="{Binding ClaudeVm.ShortPercent}" Maximum="1"
                                         Style="{StaticResource UsageBarStyle}" VerticalAlignment="Center"
                                         Margin="8,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding ClaudeVm.ShortPercent, StringFormat={}{0:P0}}"
                                       Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,5"
                              Visibility="{Binding IsCodexActive, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Codex" Foreground="#6EE7B7" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Grid.Column="1" Value="{Binding CodexPercent}" Maximum="1"
                                         Style="{StaticResource CodexBarStyle}" VerticalAlignment="Center"
                                         Margin="8,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding CodexPercent, StringFormat={}{0:P0}}"
                                       Foreground="#6EE7B7" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,5"
                              Visibility="{Binding IsGeminiActive, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gemini CLI" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Grid.Column="1" Value="{Binding GeminiPercent}" Maximum="1"
                                         Style="{StaticResource GeminiBarStyle}" VerticalAlignment="Center"
                                         Margin="8,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding GeminiPercent, StringFormat={}{0:P0}}"
                                       Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,5"
                              Visibility="{Binding IsOpenCodeActive, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OpenCode" Foreground="#FB923C" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Grid.Column="1" Value="{Binding OpenCodePercent}" Maximum="1"
                                         Style="{StaticResource OpenCodeBarStyle}" VerticalAlignment="Center"
                                         Margin="8,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding OpenCodePercent, StringFormat={}{0:P0}}"
                                       Foreground="#FB923C" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Visibility="{Binding AntigravityHasData, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Antigravity" Foreground="#A5B4FC" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Grid.Column="1" Value="{Binding AntigravityPercent}" Maximum="1"
                                         Style="{StaticResource AntigravityBarStyle}" VerticalAlignment="Center"
                                         Margin="8,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding AntigravityPercent, StringFormat={}{0:P0}}"
                                       Foreground="#A5B4FC" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer x:Name="FullUsageContent"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KeepPopupAboveTaskbar}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>

                        <!-- Update banner removed (v1.33.8): 업데이트는 좌하단 버전 클릭 → 모달로만 안내한다.
                             다운로드 진행률은 UpdateDialog 자체에 표시된다. -->

                <!-- Error panel — 메시지가 비어 있으면 숨겨서 빈 박스가 보이지 않도록 함 (Windows 10 렌더링 대응) -->
                <Border Padding="12,8" Margin="16,4"
                        Background="#2D1515" CornerRadius="8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444"
                               FontSize="10" TextWrapping="Wrap"/>
                </Border>

                <!-- Weather Section (v1.29.0) -->
                <StackPanel x:Name="WeatherSection" Margin="16,14,16,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WeatherHasLocation}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KeepPopupAboveTaskbar}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding LblWeatherSection}" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource StatBox}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                    Background="#2D2F45" Margin="0,0,10,0" VerticalAlignment="Center">
                                <!-- Segoe UI Symbol: monochrome BMP symbol font that WPF renders reliably
                                     (Segoe UI Emoji's COLR color glyphs aren't supported by WPF) -->
                                <TextBlock Text="{Binding WeatherIcon}" FontSize="15"
                                           FontFamily="Segoe UI Symbol"
                                           Foreground="#F1F5F9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WeatherShortLocation}"
                                           Foreground="#F1F5F9" FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding WeatherConditionLabel}"
                                           Foreground="#8B92B3" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding WeatherTemperatureLabel}"
                                       Foreground="#6EE7B7" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding WeatherHasCurrent, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Provider Sections -->
                <StackPanel Margin="16,14,16,14">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding LblApiQuota}" Margin="0,0,0,12"/>

                    <!-- Claude Section -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding ClaudeVm.IsActive, Converter={StaticResource BoolToVisibility}}">
                        <!-- Compact clickable row — focus 토글 -->
                        <Button Click="ClaudeFocus_Click" Style="{StaticResource AgentRowBtn}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="C" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Claude" Foreground="#F1F5F9" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ClaudeVm.ShortPercent, StringFormat={}{0:P0}}" Foreground="#A78BFA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Detail body — focused 일 때만 -->
                        <StackPanel Margin="10,6,10,0" Visibility="{Binding IsClaudeFocused, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LblFiveHour}" Foreground="#F1F5F9" FontSize="10.5"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding ClaudeVm.ShortPercent, StringFormat={}{0:P0}}" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ClaudeVm.ShortReset}" Foreground="#8B92B3" FontSize="10" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding ClaudeVm.ShortDepletion}" Foreground="#F59E0B" FontSize="10" Margin="0,2,0,0" Visibility="{Binding ClaudeVm.ShortDepletion, Converter={StaticResource StringToVisibility}}"/>
                                <!-- 페이스 마커 오버레이: 주황(사용 전체) → 보라(시간 이내) → 시간 마커 세로선 순으로 겹친다 -->
                                <Grid Grid.Row="2" Height="8" Margin="0,4,0,0"
                                      ToolTip="{Binding ClaudeVm.ShortPaceTip}">
                                    <ProgressBar Value="{Binding ClaudeVm.ShortPercent}" Maximum="1" Style="{StaticResource PaceOverBarStyle}" VerticalAlignment="Center"/>
                                    <ProgressBar Value="{Binding ClaudeVm.ShortUsageCapped}" Maximum="1" Style="{StaticResource PaceUsageBarStyle}" VerticalAlignment="Center"/>
                                    <Grid VerticalAlignment="Center" Height="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ClaudeVm.ShortTimePercent, Converter={StaticResource PercentToStar}}"/>
                                            <ColumnDefinition Width="{Binding ClaudeVm.ShortTimePercent, Converter={StaticResource PercentToStar}, ConverterParameter=inverse}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Right" Width="1.5" Height="8" Background="#E2E8F0" CornerRadius="1"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding ClaudeVm.ShortSummary}" Foreground="#8B92B3" FontSize="10" Margin="0,3,0,10"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LblSevenDay}" Foreground="#F1F5F9" FontSize="10.5"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding ClaudeVm.LongPercent, StringFormat={}{0:P0}}" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ClaudeVm.LongReset}" Foreground="#8B92B3" FontSize="10" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <!-- 페이스 마커 오버레이 (7일) — 5시간과 동일 구조 -->
                                <Grid Grid.Row="2" Height="8" Margin="0,4,0,0"
                                      ToolTip="{Binding ClaudeVm.LongPaceTip}">
                                    <ProgressBar Value="{Binding ClaudeVm.LongPercent}" Maximum="1" Style="{StaticResource PaceOverBarStyle}" VerticalAlignment="Center"/>
                                    <ProgressBar Value="{Binding ClaudeVm.LongUsageCapped}" Maximum="1" Style="{StaticResource PaceUsageBarStyle}" VerticalAlignment="Center"/>
                                    <Grid VerticalAlignment="Center" Height="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ClaudeVm.LongTimePercent, Converter={StaticResource PercentToStar}}"/>
                                            <ColumnDefinition Width="{Binding ClaudeVm.LongTimePercent, Converter={StaticResource PercentToStar}, ConverterParameter=inverse}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Right" Width="1.5" Height="8" Background="#E2E8F0" CornerRadius="1"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding ClaudeVm.LongSummary}" Foreground="#8B92B3" FontSize="10" Margin="0,3,0,0"/>

                            <!-- Extra Usage (Claude only) -->
                            <Grid Margin="0,10,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClaudeVm.ExtraUsageEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClaudeVm.IsExtraOnlyMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LblExtraCredits}" Foreground="#F1F5F9" FontSize="10.5"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding ClaudeVm.ExtraUsagePercent, StringFormat={}{0:P0}}" Foreground="#F59E0B" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ClaudeVm.ExtraUsagePercent}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ClaudeVm.ExtraCreditsLabel}" Foreground="#8B92B3" FontSize="10" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding ClaudeVm.ExtraUsagePercent}" Maximum="1" Style="{StaticResource ExtraBarStyle}" Margin="0,4,0,0"/>
                            </Grid>

                            <!-- Usage Empty Placeholder (Claude) -->
                            <TextBlock Text="{Binding LblClaudeNoUsage}" Foreground="#5A5F7A" FontSize="10" FontStyle="Italic" Margin="0,10,0,0"
                                       Visibility="{Binding ClaudeVm.IsUsageEmpty, Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="{Binding ClaudeVm.ErrorMessage}" Foreground="#EF4444" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding ClaudeVm.HasError, Converter={StaticResource BoolToVisibility}}"/>

                            <!-- API 쿨다운 안내(에러 아님) — 회색 톤으로 자동 재시도 시점만 표시 -->
                            <TextBlock Text="{Binding ClaudeVm.ApiNote}" Foreground="#8B92B3" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding ClaudeVm.ApiNote, Converter={StaticResource StringToVisibility}}"/>

                            <!-- History Chart (Claude 기준) -->
                            <StackPanel x:Name="ClaudeHistorySection" Margin="0,14,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KeepPopupAboveTaskbar}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Height="1" Background="#2D2F45" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="ChartTitleLabel" Text="{Binding ClaudeVm.HistoryChartTitle}" Style="{StaticResource SectionLabel}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border CornerRadius="4" BorderBrush="#2D2F45" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="Toggle7DayBtn" Click="Toggle7DayBtn_Click" Padding="6,2" BorderThickness="0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#2D2F45"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#3D4060"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock x:Name="Toggle7DayText" FontSize="10" Foreground="#F1F5F9"/>
                                                </Button>
                                                <Button x:Name="ToggleHourlyBtn" Click="ToggleHourlyBtn_Click" Padding="6,2" BorderThickness="0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#1E2035"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock x:Name="ToggleHourlyText" FontSize="10" Foreground="#8B92B3"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Canvas x:Name="HistoryCanvas" Height="60" Background="Transparent" ClipToBounds="True" SizeChanged="HistoryCanvas_SizeChanged"/>
                            </StackPanel>

                            <!-- Today's Stats (Claude 세션 기준) -->
                            <Border Height="1" Background="#2D2F45" Margin="0,14,0,14"/>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding LblTodayTokens}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SessionsLabel}" Foreground="#8B92B3" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <UniformGrid Columns="2" Rows="2">
                                <Border Style="{StaticResource StatBox}" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LblInput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                        <TextBlock Text="{Binding TodayInputTokens, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Foreground="#A78BFA"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatBox}" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LblOutput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                        <TextBlock Text="{Binding TodayOutputTokens, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatBox}" Margin="0,4,4,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LblCacheRead}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                        <TextBlock Text="{Binding TodayCacheRead, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Foreground="#34D399" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatBox}" Margin="4,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LblCacheWrite}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                        <TextBlock Text="{Binding TodayCacheWrite, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Foreground="#FBBF24" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding TodayCostLabel}" Foreground="#8B92B3" FontSize="10" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Codex Section -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding IsCodexActive, Converter={StaticResource BoolToVisibility}}">
                        <!-- Compact clickable row -->
                        <Button Click="CodexFocus_Click" Style="{StaticResource AgentRowBtn}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="X" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Codex" Foreground="#F1F5F9" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CodexPercent, StringFormat={}{0:P0}}" Foreground="#6EE7B7" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Detail body — focused 일 때만 -->
                        <StackPanel Margin="10,6,10,0" Visibility="{Binding IsCodexFocused, Converter={StaticResource BoolToVisibility}}">

                        <!-- v1.26.0: PlanType 라벨 ("ChatGPT Plus" 등) — v1.27.0: ShowCodexPlanBadge 토글 -->
                        <TextBlock Text="{Binding CodexPlanLabel}" Foreground="#6EE7B7" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Visibility="{Binding ShowCodexPlanBadge, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- 단기 윈도우 (primary) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CodexShortWindowLabel}" Foreground="#F1F5F9" FontSize="10.5"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding CodexPercent, StringFormat={}{0:P0}}" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CodexReset}" Foreground="#8B92B3" FontSize="10" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Height="8" Margin="0,4,0,0">
                            <ProgressBar Value="{Binding CodexPercent}" Maximum="1" Style="{StaticResource CodexBarStyle}" VerticalAlignment="Center"/>
                            <Grid VerticalAlignment="Center" Height="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding CodexShortTimePercent, Converter={StaticResource PercentToStar}}"/>
                                    <ColumnDefinition Width="{Binding CodexShortTimePercent, Converter={StaticResource PercentToStar}, ConverterParameter=inverse}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" HorizontalAlignment="Right" Width="1.5" Height="8" Background="#E2E8F0" CornerRadius="1"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="{Binding CodexSummary}" Foreground="#8B92B3" FontSize="10" Margin="0,4,0,10"/>

                        <!-- v1.26.0: 장기 윈도우 (secondary) — 응답에 데이터 있을 때만 노출 -->
                        <StackPanel Visibility="{Binding IsCodexLongVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CodexLongWindowLabel}" Foreground="#F1F5F9" FontSize="10.5"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding CodexLongPercent, StringFormat={}{0:P0}}" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CodexLongReset}" Foreground="#8B92B3" FontSize="10" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Height="8" Margin="0,4,0,0">
                                <ProgressBar Value="{Binding CodexLongPercent}" Maximum="1" Style="{StaticResource CodexBarStyle}" VerticalAlignment="Center"/>
                                <Grid VerticalAlignment="Center" Height="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding CodexLongTimePercent, Converter={StaticResource PercentToStar}}"/>
                                        <ColumnDefinition Width="{Binding CodexLongTimePercent, Converter={StaticResource PercentToStar}, ConverterParameter=inverse}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" HorizontalAlignment="Right" Width="1.5" Height="8" Background="#E2E8F0" CornerRadius="1"/>
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding CodexLongSummary}" Foreground="#8B92B3" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Usage Empty Placeholder (Codex) -->
                        <TextBlock Text="{Binding LblCodexNoUsage}" Foreground="#5A5F7A" FontSize="10" FontStyle="Italic" Margin="0,10,0,0"
                                   Visibility="{Binding IsCodexUsageEmpty, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- 오늘의 토큰 4타일 (Claude와 동일 레이아웃) -->
                        <Border Height="1" Background="#2D2F45" Margin="0,12,0,10"
                                Visibility="{Binding IsCodexUsageEmpty, Converter={StaticResource BoolToVisibilityInverse}}"/>
                        <UniformGrid Columns="2" Rows="2"
                                     Visibility="{Binding IsCodexUsageEmpty, Converter={StaticResource BoolToVisibilityInverse}}">
                            <Border Style="{StaticResource StatBox}" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblInput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding CodexInputLabel}" Style="{StaticResource StatValue}" Foreground="#6EE7B7" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="4,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblOutput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding CodexOutputLabel}" Style="{StaticResource StatValue}" Foreground="#34D399" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblCacheRead}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding CodexCacheReadLabel}" Style="{StaticResource StatValue}" Foreground="#A7F3D0" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblCacheWrite}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding CodexCacheWriteLabel}" Style="{StaticResource StatValue}" Foreground="#5A5F7A" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{Binding CodexNote}" Foreground="#5A5F7A" FontSize="10" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding CodexDataSource}" Foreground="#3D4266" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Gemini Section -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding IsGeminiActive, Converter={StaticResource BoolToVisibility}}">
                        <!-- Compact clickable row -->
                        <Button Click="GeminiFocus_Click" Style="{StaticResource AgentRowBtn}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="G" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Gemini CLI" Foreground="#F1F5F9" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding GeminiRequestsLabel}" Foreground="#60A5FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Detail body — focused 일 때만 -->
                        <StackPanel Margin="10,6,10,0" Visibility="{Binding IsGeminiFocused, Converter={StaticResource BoolToVisibility}}">
                        <!-- Usage Empty Placeholder (Gemini) -->
                        <TextBlock Text="{Binding LblGeminiNoUsage}" Foreground="#5A5F7A" FontSize="10" FontStyle="Italic" Margin="0,0,0,10"
                                   Visibility="{Binding IsGeminiUsageEmpty, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- 오늘의 토큰 4타일 (Claude와 동일 레이아웃) -->
                        <UniformGrid Columns="2" Rows="2"
                                     Visibility="{Binding IsGeminiUsageEmpty, Converter={StaticResource BoolToVisibilityInverse}}">
                            <Border Style="{StaticResource StatBox}" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblInput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding GeminiInputLabel}" Style="{StaticResource StatValue}" Foreground="#60A5FA" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="4,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblOutput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding GeminiOutputTokensLabel}" Style="{StaticResource StatValue}" Foreground="#93C5FD" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblCacheRead}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding GeminiCacheReadLabel}" Style="{StaticResource StatValue}" Foreground="#BFDBFE" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblCacheWrite}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding GeminiCacheWriteLabel}" Style="{StaticResource StatValue}" Foreground="#5A5F7A" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding GeminiNote}" Foreground="#5A5F7A" FontSize="10" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding GeminiErrorMessage}" Foreground="#EF4444" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding GeminiHasError, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- OpenCode Section -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding IsOpenCodeActive, Converter={StaticResource BoolToVisibility}}">
                        <!-- Compact clickable row -->
                        <Button Click="OpenCodeFocus_Click" Style="{StaticResource AgentRowBtn}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#F97316" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="O" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="OpenCode" Foreground="#F1F5F9" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding OpenCodeRequestCountLabel}" Foreground="#FB923C" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Detail body — focused 일 때만 -->
                        <StackPanel Margin="10,6,10,0" Visibility="{Binding IsOpenCodeFocused, Converter={StaticResource BoolToVisibility}}">
                        <!-- Usage Empty Placeholder (OpenCode) -->
                        <TextBlock Text="{Binding LblOpenCodeNoUsage}" Foreground="#5A5F7A" FontSize="10" FontStyle="Italic" Margin="0,0,0,10"
                                   Visibility="{Binding IsOpenCodeUsageEmpty, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- 오늘의 토큰 4타일 (Claude와 동일 레이아웃) -->
                        <UniformGrid Columns="2" Rows="2"
                                     Visibility="{Binding IsOpenCodeUsageEmpty, Converter={StaticResource BoolToVisibilityInverse}}">
                            <Border Style="{StaticResource StatBox}" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblInput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding OpenCodeInputLabel}" Style="{StaticResource StatValue}" Foreground="#FB923C" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="4,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblOutput}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding OpenCodeOutputLabel}" Style="{StaticResource StatValue}" Foreground="#FDBA74" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblCacheRead}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding OpenCodeCacheReadLabel}" Style="{StaticResource StatValue}" Foreground="#FED7AA" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LblCacheWrite}" Style="{StaticResource StatLabel}" Foreground="#8B92B3"/>
                                    <TextBlock Text="{Binding OpenCodeCacheWriteLabel}" Style="{StaticResource StatValue}" Foreground="#FBBF24" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding OpenCodeNote}" Foreground="#5A5F7A" FontSize="10" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding OpenCodeErrorMessage}" Foreground="#EF4444" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding OpenCodeHasError, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Antigravity Section (v1.31.0) — per-model quota panel from Google's Antigravity IDE -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding AntigravityHasData, Converter={StaticResource BoolToVisibility}}">
                        <!-- Compact clickable row -->
                        <Button Click="AntigravityFocus_Click" Style="{StaticResource AgentRowBtn}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#6366F1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="A" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Antigravity" Foreground="#F1F5F9" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding AntigravityPercent, StringFormat={}{0:P0}}" Foreground="#A5B4FC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Detail body — focused 일 때만 -->
                        <StackPanel Margin="10,6,10,0" Visibility="{Binding IsAntigravityFocused, Converter={StaticResource BoolToVisibility}}">
                            <Border Margin="0,4,0,0" Padding="10,8" Background="#1F2433" CornerRadius="8">
                                <StackPanel>
                                    <!-- Header row: brand + tier -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding AntigravityPaidTierName}" Foreground="#A5B4FC" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AntigravityTierName}" Foreground="#818CF8" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                    <!-- Per-model quota list (wrapped in ScrollViewer to prevent screen overflow) -->
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AntigravityModels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- 1st Row: Model Name & Usage Status -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="#F1F5F9" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding UsageLabel}" Foreground="#A5B4FC" FontSize="10.5" FontWeight="Bold"/>
                                                        </Grid>
                                                        <!-- 2nd Row: Usage Progress Bar -->
                                                        <ProgressBar Grid.Row="1" Value="{Binding UsagePercent}" Maximum="1" Height="4" Margin="0,5,0,3" Foreground="#818CF8" Background="#2A2F45" BorderThickness="0"/>
                                                        <!-- 3rd Row: Reset Time Info -->
                                                        <TextBlock Grid.Row="2" Text="{Binding ResetAtLabel}" Foreground="#6B7280" FontSize="9" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <!-- Error line (if any) -->
                                    <TextBlock Text="{Binding AntigravityErrorMessage}" Foreground="#EF4444" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding AntigravityHasError, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border x:Name="PopupFooter" Grid.Row="2" Padding="16,12" Background="#1A1D2E" CornerRadius="0,0,16,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KeepPopupAboveTaskbar}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 좌측: 버전 클릭 → 업데이트 확인 (툴팁에 마지막 확인 시각/결과) -->
                        <Button Grid.Column="0" Command="{Binding ManualCheckForUpdateCommand}"
                                Style="{StaticResource GhostBtn}" VerticalAlignment="Center"
                                ToolTip="{Binding UpdateCheckTooltip}">
                            <TextBlock Text="{Binding CurrentVersionLabel}" Foreground="#5A5F7A" FontSize="9"/>
                        </Button>
                        <!-- 중앙: 업데이트 체크 메시지 — 길어지면 줄바꿈으로 처리해 우측 버튼을 침범하지 않음 -->
                        <TextBlock Grid.Column="1" Text="{Binding UpdateCheckLabel}" Foreground="#A78BFA" FontSize="9"
                                   Margin="6,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding UpdateCheckLabel, Converter={StaticResource StringToVisibility}}"/>
                        <!-- 우측: 설정 + 종료 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="SettingsBtn_Click" Cursor="Hand" Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                                                        <TextBlock x:Name="Icon" Text="⚙" Foreground="#5A5F7A" FontSize="13" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Icon" Property="Foreground" Value="#A78BFA"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Click="QuitBtn_Click" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="4,2">
                                                        <TextBlock x:Name="Lbl" Text="{Binding LblQuit}" Foreground="#B87171" FontSize="10" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Lbl" Property="Foreground" Value="#EF4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
