<Window x:Class="ClaudeUsageTray.Views.MobileConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Phone"
        Width="400"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0F1117"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1D2E"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2D2F45"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B92B3"/>
        <SolidColorBrush x:Key="TextDim" Color="#5A5F7A"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B92B3"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lbl" Property="Foreground" Value="#C4B5FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Lbl" Property="Foreground" Value="#5A5F7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#8B5CF6" CornerRadius="8" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Border Background="{StaticResource BgBrush}" CornerRadius="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="16,16,0,0" Padding="20,14"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="TitleText" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,14,20,6">
                        <TextBlock x:Name="HintText" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>

                        <Border x:Name="QrFrame" Background="White" CornerRadius="10" Padding="10" Margin="0,12,0,6"
                                HorizontalAlignment="Center" Width="236" Height="236">
                            <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"/>
                        </Border>
                        <Grid Margin="0,0,0,4">
                            <TextBlock x:Name="CountdownText" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center"/>
                            <Button x:Name="NewQrButton" Style="{StaticResource LinkBtn}" HorizontalAlignment="Right" Click="NewQrButton_Click"/>
                        </Grid>
                        <!-- 같은 일회용 코드를 다른 PC 에 붙여 넣으면 PC 동기화가 된다(#223) -->
                        <Button x:Name="CopyCodeButton" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,0,0,4" Click="CopyCodeButton_Click"/>
                        <TextBlock x:Name="CopyCodeResult" Foreground="#7C83A4" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="WatchingText" Foreground="#10B981" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <TextBlock x:Name="PathsHeader" Style="{StaticResource SectionLabel}"/>
                        <ItemsControl x:Name="PathsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#C4C9E0" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="FirewallText" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <Button x:Name="FirewallButton" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Click="FirewallButton_Click"/>

                        <TextBlock x:Name="DevicesHeader" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="NoDevicesText" Foreground="{StaticResource TextDim}" FontSize="11"/>
                        <ItemsControl x:Name="DevicesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1D2E" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="#F1F5F9" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#5A5F7A" FontSize="10"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource LinkBtn}" Content="{Binding RevokeLabel}"
                                                    Tag="{Binding DeviceId}" VerticalAlignment="Center" Click="RevokeButton_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="GetAppButton" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="GetAppButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="20,10,20,16">
                    <Button x:Name="CloseButton" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Click="CloseButton_Click"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
